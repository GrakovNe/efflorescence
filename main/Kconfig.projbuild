menu "Efflorescence"

    config APP_TOUCH_GND_GPIO
        int "GPIO that grounds the touch sensor (driven low), -1 for none"
        default 3

    config APP_TOUCH_IO_GPIO
        int "Touch sensor output GPIO (high when touched)"
        default 4

    config APP_TOUCH_VCC_GPIO
        int "GPIO that powers the touch sensor (driven high), -1 for none"
        default 5

    config APP_LED_GND_GPIO
        int "GPIO that grounds the LED driver input (driven low), -1 for none"
        default 6

    config APP_LED_PWM_GPIO
        int "LED driver PWM GPIO (high = LED on)"
        default 7

    config APP_PWM_FREQ_HZ
        int "LED PWM frequency, Hz"
        default 1250

    config APP_PWM_BITS
        int "LED PWM resolution, bits"
        range 8 14
        default 14

    config APP_LED_DUTY_MIN_PERMILLE
        int "Lowest PWM duty the LED driver still passes, per mille"
        range 0 500
        default 10

    config APP_WIFI_LISTEN_INTERVAL
        int "Listen to every Nth beacon of the access point"
        range 1 10
        default 1
        help
            1 hears every beacon and with it every broadcast: the lamp
            answers ARP and mDNS at once. More saves power in proportion
            and makes the lamp slow or deaf to those.

    config APP_UPDATE_URL
        string "Update manifest URL"
        default "https://grakovne.github.io/efflorescence/ota.json"

endmenu
