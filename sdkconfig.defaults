CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_FREERTOS_HZ=1000

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The case has no USB: a bad OTA image has to fall back by itself. The
# bootloader cannot be updated over the air, so this is set from day one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_LWIP_NETIF_LOOPBACK=y

CONFIG_ESP_WIFI_NVS_ENABLED=n

CONFIG_LWIP_MAX_SOCKETS=16

CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# For the "skip certificate verification" MQTT option.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# The API has no authentication anyway, and a plain HTTP manifest on the
# LAN is how updates are tried before a release.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# Time spent in each power mode, for /api/v1/debug/pm.
CONFIG_PM_PROFILING=y
# Every beacon wakes the chip. The shorter each wake, the longer the
# battery: keep the sleep path in RAM, switch the radio's digital half
# off in between, and do not sit awake waiting for a beacon that was lost.
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_PM_RTOS_IDLE_OPT=y
CONFIG_ESP_WIFI_SLP_IRAM_OPT=y
CONFIG_ESP_PHY_MAC_BB_PD=y
CONFIG_ESP_WIFI_SLP_BEACON_LOST_OPT=y

# The 3.3 V rail falling to 2.92 V means the battery is at about 3 V:
# empty. The reset this causes is how the lamp learns of it.
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_4=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
