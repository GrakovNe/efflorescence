CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_FREERTOS_HZ=1000

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The case has no USB: a bad OTA image has to fall back by itself. The
# bootloader cannot be updated over the air, so this is set from day one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_LWIP_NETIF_LOOPBACK=y

CONFIG_ESP_WIFI_NVS_ENABLED=n

CONFIG_LWIP_MAX_SOCKETS=16

CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# For the "skip certificate verification" MQTT option.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# The API has no authentication anyway, and a plain HTTP manifest on the
# LAN is how updates are tried before a release.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
